{
    "name": "zofe/shop-module",
    "description": "shop module for rapyd-admin application",
    "license": "mit",
    "type": "rapyd-module",
    "authors": [
        {
            "name": "Felice",
            "email": "felice.ostuni@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "11.0.10"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Shop\\": "./",
            "App\\Modules\\Shop\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Modules\\Shop\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "zofe/rapyd-module-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Modules\\Shop\\ShopServiceProvider"
            ],
            "aliases": {
                "Cart": "App\\Modules\\Shop\\CartFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}